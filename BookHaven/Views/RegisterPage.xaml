<Page x:Class="BookHaven.Views.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Регистрация"
      Background="#1e1e2e">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Width="320">
        <StackPanel>

            <TextBlock Text="Регистрация" FontSize="28" FontWeight="Bold"
                       Foreground="White" HorizontalAlignment="Center"
                       Margin="0,0,0,30"/>

            <TextBlock Text="Логин" Foreground="#aaaaaa" Margin="0,0,0,5"/>
            <TextBox x:Name="LoginBox" Height="36" Padding="8,8,8,8"
                     Background="#2a2a3e" Foreground="White" BorderBrush="#555"
                     CaretBrush="White"/>

            <TextBlock Text="Email" Foreground="#aaaaaa" Margin="0,15,0,5"/>
            <TextBox x:Name="EmailBox" Height="36" Padding="8,8,8,8"
                     Background="#2a2a3e" Foreground="White" BorderBrush="#555"
                     CaretBrush="White"/>

            <TextBlock Text="Отображаемое имя" Foreground="#aaaaaa" Margin="0,15,0,5"/>
            <TextBox x:Name="DisplayNameBox" Height="36" Padding="8,8,8,8"
                     Background="#2a2a3e" Foreground="White" BorderBrush="#555"
                     CaretBrush="White"/>

            <TextBlock Text="Пароль" Foreground="#aaaaaa" Margin="0,15,0,5"/>
            <PasswordBox x:Name="PasswordBox" Height="36" Padding="8,8,8,8"
                         Background="#2a2a3e" Foreground="White" BorderBrush="#555"/>

            <TextBlock x:Name="ErrorText" Foreground="#ff5555"
                       HorizontalAlignment="Center" Margin="0,10,0,0"
                       TextWrapping="Wrap"/>

            <Button Content="Зарегистрироваться" Height="40" Margin="0,20,0,8"
                    Background="#7c3aed" Foreground="White"
                    BorderThickness="0" FontSize="14"
                    Click="RegisterBtn_Click"/>

            <Button Content="Уже есть аккаунт? Войти" Height="36"
                    Background="Transparent" Foreground="#7c3aed"
                    BorderBrush="#7c3aed" BorderThickness="1"
                    Click="BackBtn_Click"/>

        </StackPanel>
    </Grid>
</Page>