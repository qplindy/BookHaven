<Page x:Class="BookHaven.Views.CatalogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Каталог книг"
      Background="#1e1e2e">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ПАНЕЛЬ ПОИСКА И ФИЛЬТРОВ -->
        <StackPanel Grid.Row="0" Background="#12121f">

            <TextBlock Text="Каталог книг" FontSize="24" FontWeight="Bold"
                       Foreground="White" Margin="0,0,0,12"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>

                <!-- Поиск -->
                <TextBox x:Name="SearchBox" Grid.Column="0"
                         Height="36" Padding="8,8,8,8" Margin="0,0,8,0"
                         Background="#2a2a3e" Foreground="White"
                         BorderBrush="#555" CaretBrush="White"
                         Text="Поиск по названию или автору..."
                         GotFocus="SearchBox_GotFocus"
                         LostFocus="SearchBox_LostFocus"
                         TextChanged="SearchBox_TextChanged"/>

                <!-- Сортировка -->
                <ComboBox x:Name="SortBox" Grid.Column="1"
                          Height="36" Margin="0,0,8,0"
                          Background="#2a2a3e" Foreground="White"
                          BorderBrush="#555"
                          SelectionChanged="SortBox_SelectionChanged">
                    <ComboBoxItem Content="По названию" IsSelected="True"/>
                    <ComboBoxItem Content="По оценке"/>
                </ComboBox>

                <!-- Фильтр по жанру -->
                <ComboBox x:Name="GenreBox" Grid.Column="2"
                          Height="36"
                          Background="#2a2a3e" Foreground="White"
                          BorderBrush="#555"
                          SelectionChanged="GenreBox_SelectionChanged"/>
            </Grid>
        </StackPanel>

        <!-- СЕТКА КНИГ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <WrapPanel x:Name="BooksPanel" Margin="16"/>
        </ScrollViewer>
    </Grid>
</Page>